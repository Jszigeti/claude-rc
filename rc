#!/usr/bin/env bash
# rc: serves folders over Claude Code Remote Control, one `claude remote-control` per folder, in tmux.
#   rc                       start what is missing, then list servers and candidate folders
#   rc add <folder or name>  serve a folder (a path, or just its name), or restart a served one
#   rc rm <name or folder>   stop a server and forget its folder

CONF=$HOME/.config/rc
STATE=$HOME/.local/state/rc
FOLDERS=$CONF/folders
SELF=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")
PAUSE=${RC_PAUSE:-60}      # tests shorten the waits
STAGGER=${RC_STAGGER:-3}
API=${RC_API:-https://api.anthropic.com}
EXCLUDED=(Library Documents Desktop Downloads Pictures Movies Music)  # macOS asks before listing these
export TMUX_TMPDIR=$STATE  # under /tmp, systemd-tmpfiles may purge the socket (tmux #4640)

t() { tmux -L rc -f "$CONF/tmux.conf" "$@"; }

COLOR=false  # only for a human at a terminal (clig.dev, no-color.org); decided once, before any $(...)
[[ -t 1 && -z ${NO_COLOR:-} && ${TERM:-} != dumb ]] && COLOR=true

paint() { if $COLOR; then printf '\033[%sm%s\033[0m' "$1" "$2"; else printf '%s' "$2"; fi; }

usage() { sed -n '2,5p' "$SELF" | sed 's/^# \{0,1\}//'; }

prepare() {
  mkdir -p "$CONF" "$STATE"
  [[ -f $CONF/tmux.conf ]] || printf 'set -g default-size 200x50\nset -g history-limit 2000\n' > "$CONF/tmux.conf"
}

# --- folders: one "name=absolute path" line per served folder

served() { [[ -f $FOLDERS ]] && grep -v '^[[:space:]]*$' "$FOLDERS" || true; }

path_of() {
  local l
  while IFS= read -r l; do [[ ${l%%=*} == "$1" ]] && { echo "${l#*=}"; return 0; }; done < <(served)
  return 1
}

name_of_path() {
  local l
  while IFS= read -r l; do [[ ${l#*=} == "$1" ]] && { echo "${l%%=*}"; return 0; }; done < <(served)
  return 1
}

name_for() { # the name shown in the app: ~ is home, otherwise the folder name in lowercase with dashes
  [[ $1 == "$HOME" ]] && { echo home; return; }
  basename "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g; s/^-*//'
}

free_name() {
  local base n i=2
  base=$(name_for "$1")
  n=$base
  while path_of "$n" >/dev/null; do n=$base-$i; i=$((i + 1)); done
  echo "$n"
}

# --- candidates: folders worth serving, newest first

decode() { # rebuild a path from its ~/.claude/projects name, where every non-alphanumeric became -
  local dir=$1 rest=$2 e enc
  [[ -z $rest ]] && { echo "$dir"; return 0; }
  for e in "$dir"/* "$dir"/.[!.]*; do
    [[ -d $e ]] || continue
    enc=${e##*/}
    enc=${enc//[^A-Za-z0-9]/-}
    if [[ $rest == "$enc" ]]; then decode "$e" "" && return 0
    elif [[ $rest == "$enc"-* ]]; then decode "$e" "${rest#"$enc"-}" && return 0
    fi
  done
  return 1
}

excluded() { # $1: a folder name right under ~
  local d
  for d in "${EXCLUDED[@]}"; do [[ $1 == "$d" ]] && return 0; done
  return 1
}

candidates() { # "epoch<TAB>path": Claude Code history under ~ first, then git repos right under ~
  local d enc top f p e h=${HOME//[^A-Za-z0-9]/-}
  {
    for d in "$HOME"/.claude/projects/*/; do
      enc=$(basename "$d")
      [[ $enc == "$h" || $enc == "$h"-* ]] || continue
      top=${enc#"$h"-}
      excluded "${top%%-*}" && continue
      p=$(decode "" "${enc#-}") || continue
      f=$(ls -t "$d" | head -1)
      [[ -n $f ]] && printf '1\t%s\t%s\n' "$(date -r "$d$f" +%s)" "$p"
    done
    for d in "$HOME"/*/; do
      p=${d%/}
      excluded "${p##*/}" || [[ ! -d $p/.git ]] || printf '2\t%s\t%s\n' "$(git -C "$p" log -1 --format=%ct 2>/dev/null || echo 0)" "$p"
    done
  } | sort -t $'\t' -k1,1n -k2,2nr | awk -F '\t' '!seen[$3]++ { print $2 "\t" $3 }' |
    while IFS=$'\t' read -r e p; do name_of_path "$p" >/dev/null || printf '%s\t%s\n' "$e" "$p"; done
}

age() {
  local s
  s=$(( $(date +%s) - $1 ))
  if (( s < 60 )); then echo "just now"
  elif (( s < 3600 )); then echo "$((s / 60)) min ago"
  elif (( s < 86400 )); then echo "$((s / 3600)) h ago"
  elif (( s < 172800 )); then echo "yesterday"
  else echo "$((s / 86400)) d ago"
  fi
}

short() { [[ $1 == "$HOME" || $1 == "$HOME/"* ]] && echo "~${1#"$HOME"}" || echo "$1"; }

# --- servers: one tmux session per folder, running serve_loop

running() { t has-session -t "=$1" 2>/dev/null; }

pane() { t capture-pane -pJ -t "=$1:" 2>/dev/null; }

last_line() { pane "$1" | grep -v '^[[:space:]]*$' | tail -1; }

start() { # a session that already exists was started by a concurrent rc
  t new-session -d -s "$1" "$SELF" _loop "$1" "$2" 2>/dev/null || true
}

alive() { pgrep -f "remote-control --name $1 " >/dev/null; }

stop() { # claude refuses to start while the previous server of the same folder still runs
  local i
  t kill-session -t "=$1" 2>/dev/null || true
  for i in $(seq 50); do alive "$1" || return 0; sleep 0.2; done
}

logged_in() { # Remote Control needs a claude.ai login, not an API key
  local out re='"authMethod": *"claude\.ai"'
  out=$(claude auth status 2>/dev/null) && [[ $out =~ $re ]]
}

notify() {
  if command -v osascript >/dev/null; then osascript -e "display notification \"$1\" with title \"rc\""
  elif command -v notify-send >/dev/null; then notify-send rc "$1"
  fi
  return 0
}

answer_prompts() { # answers y to the trust and consent prompts until connected; only listed folders get a serve_loop
  until pane "$1" | grep -qE "Ready|Connected"; do
    last_line "$1" | grep -qE 'Trust .*\[y/N\] *$|Enable Remote Control\? \(y/n\) *$' &&
      t send-keys -t "=$1:" y Enter
    sleep 1
  done
}

serve_loop() {
  local name=$1 restarts=0
  cd "$2"
  while :; do
    if logged_in; then
      rm -f "$STATE/login-notified"
      clear  # the previous run's pane would read as connected
      answer_prompts "$name" &
      claude remote-control --name "$name" --spawn same-dir || true  # its own session keeps the environment, so open sessions survive a restart
      kill "$!" 2>/dev/null || true
      restarts=$((restarts + 1))
      echo "$restarts" > "$STATE/$name"
    elif [[ ! -e $STATE/login-notified ]]; then
      : > "$STATE/login-notified"
      if command -v claude >/dev/null; then notify "Claude login expired: run claude auth login"
      else notify "claude is not in rc's PATH: rerun the installer"; fi
    fi
    sleep "$PAUSE"
  done
}

find_folder() { # a path, a folder here or in ~, or a recent folder with that name: no ~ to type on a phone
  local p e
  for p in "$1" "$HOME/$1"; do [[ -d $p ]] && { (cd "$p" && pwd); return 0; }; done
  while IFS=$'\t' read -r e p; do [[ ${p##*/} == "$1" ]] && { echo "$p"; return 0; }; done < <(candidates)
  return 1
}

cmd_add() {
  [[ $# -eq 1 ]] || { usage >&2; return 2; }
  local name path new=""
  if path=$(path_of "$1"); then
    name=$1
  else
    path=$(find_folder "$1") || { echo "rc: no folder $1 here, in your home folder or among your recent folders" >&2; return 1; }
    name=$(name_of_path "$path") || { name=$(free_name "$path"); echo "$name=$path" >> "$FOLDERS"; new=1; }
  fi
  stop "$name"
  start "$name" "$path"
  echo "✓ $name is ready in the Claude app, Code tab"
  # the server pre-creates one session; archived once, it is not recreated on restart
  [[ -z $new ]] || echo "  It comes with a first session: use it, or archive it once and it won't come back."
}

wait_network() {
  local i
  for i in $(seq 30); do curl -s -o /dev/null --max-time 3 "$API" && return 0; sleep 5; done
  echo "rc: $API unreachable, starting anyway" >&2
}

state_of() { # a glyph, then the state in words; the screen only tells a pending question apart
  if ! running "$1"; then echo "$(paint 31 ×) stopped"
  elif ! alive "$1"; then echo "$(paint 33 -) restarting ($(cat "$STATE/$1" 2>/dev/null || echo 0)) · $(last_line "$1" | cut -c1-40)"
  elif last_line "$1" | grep -qE '\[y/N\] *$|\(y/n\) *$'; then echo "$(paint 33 !) waiting for an answer · $(last_line "$1" | cut -c1-40)"
  else echo "$(paint 32 ✓) online"
  fi
}

list_all() {
  local l e p s
  if [[ -e $STATE/login-notified ]]; then
    printf 'Claude is logged out. Every server is waiting.\nLog in with: claude auth login\n'
    return 0
  fi
  if [[ -n $(served) ]]; then
    echo "Open from the Claude app, Code tab"
    while IFS= read -r l; do
      s=$(state_of "${l%%=*}")
      printf '  %s %-12s %-24s %s\n' "${s%% *}" "${l%%=*}" "$(short "${l#*=}")" "${s#* }"
    done < <(served)
  else
    echo "No folder served yet."
  fi
  l=$(candidates | head -5)
  [[ -n $l ]] || return 0
  printf '\nUsed recently, not served\n'
  while IFS=$'\t' read -r e p; do printf '  %-24s %-28s used %s\n' "${p##*/}" "$(short "$p")" "$(age "$e")"; done <<< "$l"
  echo '  (use "rc add <name>" to serve one)'
}

cmd_default() {
  local l missing=()
  while IFS= read -r l; do running "${l%%=*}" || missing+=("$l"); done < <(served)
  if (( ${#missing[@]} )); then
    printf 'Starting %s…\n' "$(printf '%s\n' "${missing[@]%%=*}" | paste -sd, - | sed 's/,/, /g')"
    wait_network
    for l in "${missing[@]}"; do start "${l%%=*}" "${l#*=}"; sleep "$STAGGER"; done
    echo
  fi
  list_all
}

cmd_rm() {
  [[ $# -eq 1 ]] || { usage >&2; return 2; }
  local name=$1 path
  if ! path_of "$name" >/dev/null; then  # a folder name or path, like rc add
    path=$(find_folder "$1") && name=$(name_of_path "$path") || { echo "rc: no server for $1" >&2; return 1; }
  fi
  [[ $name != home ]] || { echo "rc: home is your way in from the phone; edit $FOLDERS to remove it" >&2; return 1; }
  stop "$name"
  grep -v "^$name=" "$FOLDERS" > "$FOLDERS.tmp" || true
  mv "$FOLDERS.tmp" "$FOLDERS"
  rm -f "$STATE/$name"
  echo "✓ $name removed"
}

main() {
  set -eu
  prepare
  case ${1:-} in
    "") cmd_default ;;
    add) shift; cmd_add "$@" ;;
    rm) shift; cmd_rm "$@" ;;
    _loop) shift; serve_loop "$@" ;;
    -h | --help) usage ;;
    *) usage >&2; return 2 ;;
  esac
}

[[ ${BASH_SOURCE[0]} != "$0" ]] || main "$@"
